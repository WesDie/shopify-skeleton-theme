{% comment %}
  Enhanced product section with modern design and JavaScript functionality.
  Features: Image gallery with zoom, variant selection, quantity controls, and AJAX add to cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer></script>

<div class="product">
  <!-- Product Images -->
  <div class="product-media">
    <div class="product-media__gallery">
      {% if product.images.size > 0 %}
        <div class="product-media__main">
          {% render 'image', 
            class: 'product-image', 
            image: product.featured_image,
            width: 800,
            height: 800,
            loading: 'eager'
          %}
        </div>
        
        {% if product.images.size > 1 %}
          <div class="product-media__thumbs">
            {% for image in product.images %}
              <div class="product-media__thumb" data-image-index="{{ forloop.index0 }}">
                {% render 'image', 
                  class: 'product-thumb', 
                  image: image,
                  width: 120,
                  height: 120
                %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="product-media__main">
          <div class="product-image-placeholder">
            <svg class="placeholder-svg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="120" height="120" fill="#f3f3f3"/>
              <path d="M30 90L60 60L90 90" stroke="#ccc" stroke-width="2" fill="none"/>
              <circle cx="45" cy="45" r="8" stroke="#ccc" stroke-width="2" fill="none"/>
            </svg>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Product Information -->
  <div class="product-content">
    <div class="product-info">
      <h1 class="product-info__title">{{ product.title }}</h1>
      
      <div class="product-info__price">
        {% assign current_variant = product.selected_or_first_available_variant %}
        
        <span class="product-info__price-current">
          {{ current_variant.price | money }}
        </span>
        
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="product-info__price-compare">
            {{ current_variant.compare_at_price | money }}
          </span>
          {% assign discount = current_variant.compare_at_price | minus: current_variant.price %}
          {% assign discount_percent = discount | times: 100 | divided_by: current_variant.compare_at_price %}
          <span class="product-info__badge">
            Save {{ discount_percent }}%
          </span>
        {% endif %}
      </div>

      {% if product.description != blank %}
        <div class="product-info__description">
          {{ product.description }}
        </div>
      {% endif %}
    </div>

    <!-- Product Form -->
    <div class="product-form">
      {% form 'product', product, class: 'product-form__form' %}
        <!-- Hidden select for Shopify's cart functionality -->
        <select name="id" style="display: none;">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}selected="selected"{% endif %}
            >
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>

        {% if product.variants.size > 1 %}
          <div class="product-form__group">
            <label class="product-form__label">Choose an option:</label>
            <div class="product-form__variants">
              {% for variant in product.variants %}
                <div 
                  class="variant-option"
                  data-variant-id="{{ variant.id }}"
                  data-available="{{ variant.available }}"
                  data-inventory="{{ variant.inventory_quantity }}"
                  data-price="{{ variant.price }}"
                  {% if variant.featured_image %}
                    data-image="{{ variant.featured_image | image_url: width: 800 }}"
                  {% endif %}
                >
                  <span class="variant-option__title">{{ variant.title }}</span>
                  <span class="variant-option__price">{{ variant.price | money }}</span>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- Quantity Selector -->
        <div class="product-form__group">
          <label class="product-form__label" for="quantity">Quantity:</label>
          <div class="quantity-selector">
            <button type="button" class="quantity-selector__btn quantity-decrease" aria-label="Decrease quantity">
              −
            </button>
            <input 
              type="number" 
              name="quantity" 
              id="quantity"
              class="quantity-selector__input" 
              min="1" 
              value="1"
              max="{{ current_variant.inventory_quantity | default: 999 }}"
            >
            <button type="button" class="quantity-selector__btn quantity-increase" aria-label="Increase quantity">
              +
            </button>
          </div>
        </div>

        <!-- Add to Cart Actions -->
        <div class="product-form__actions">
          <button 
            type="submit" 
            class="btn btn--primary btn--add-to-cart"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              Add to cart
            {% else %}
              Sold out
            {% endif %}
          </button>
          
          {{ form | payment_button }}
        </div>
      {% endform %}
    </div>

    <!-- Product Features -->
    <div class="product-features">
      <div class="product-feature">
        <svg class="product-feature__icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="product-feature__text">Free shipping on orders over $50</span>
      </div>
      
      <div class="product-feature">
        <svg class="product-feature__icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"></path>
        </svg>
        <span class="product-feature__text">30-day return policy</span>
      </div>
      
      <div class="product-feature">
        <svg class="product-feature__icon" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="product-feature__text">Secure checkout</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_video",
      "label": "Enable product videos",
      "default": true
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
